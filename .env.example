APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
API_URL=
API_URL_HOME=
BASE_URL=
LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
APP_IDS=
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

LINKEDIN_ID=
LINKEDIN_SECRET=
LINKEDIN_URL=

ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=

# Stripe - get keys from https://dashboard.stripe.com/apikeys
STRIPE_CLIENT_ID=
STRIPE_PRODUCT_ID=
STRIPE_PLAN_ID=
STRIPE_API_KEY_PUBLISHABLE=pk_live_your_publishable_key_here
STRIPE_API_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2022-11-15

# EasyPost - get key from https://www.easypost.com/account/api-keys
EASYPOST_API_KEY=your_easypost_api_key_here

MAIL_DRIVER=mailgun
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_SECRET=your_mailgun_secret_here

# ActiveCampaign - get from https://youracccount.activehosted.com/app/settings/developer
ACTIVECAMPAIGN_API_URL=https://youracccount.api-us1.com
ACTIVECAMPAIGN_API_KEY=your_activecampaign_key_here

# Facebook OAuth - get from https://developers.facebook.com/apps/
FB_APP_ID=
FB_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here
FACEBOOK_REDIRECT=https://your-domain.com/facebook-callback

# Google OAuth - get from https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT=https://your-domain.com/google-callback

# Zendesk - get from https://your-subdomain.zendesk.com/admin/apps-integrations/apis/apis/
ZENDESK_SUBDOMAIN=your_zendesk_subdomain
ZENDESK_USERNAME=your_zendesk_email
ZENDESK_TOKEN=your_zendesk_token_here

SUPPORT_EMAIL=support@your-domain.com
NO_REPLY_EMAIL=no-reply@your-domain.com

POSTEXPIREDURATION=6
ANALYTICS_VIEW_ID=

# Sentry - get from https://sentry.io/settings/
SENTRY_LARAVEL_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_DSN_PUBLIC="${SENTRY_LARAVEL_DSN}"

CHECK=
ESCROW_TEST=false
ESCROW_DAYS=5
ESCROW_MINS=2

base_url=https://your-domain.com
register_text="Please check your email and verify the link to complete the process."
User_restrict=false
Passcode=
